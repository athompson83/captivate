# ---------------------------------------------------------------------------
# Captivate environment
#
# Copy to .env.local for development, or set these in your hosting provider.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays server-side.
# ---------------------------------------------------------------------------

# Required. Your Supabase project URL and its publishable (anon) key.
# The publishable key is public by design: row level security is the boundary,
# not key secrecy. See docs/SECURITY.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional. Enables AI authoring: the narrative map, scene generation, speaker
# notes and the text tools. Without it those routes return a clear
# "not configured" state and a deterministic generator produces an editable
# structural draft instead. Never expose this to the browser.
ANTHROPIC_API_KEY=

# Optional, and an alternative to the key above rather than a companion to it.
# One OpenRouter key reaches every model it fronts, so a deployment with no
# Anthropic account can still generate. Setting only this switches the app onto
# it; setting both keeps Anthropic, because adding a key should not move a
# working deployment onto a different gateway and a different bill without
# somebody choosing it. Never expose this to the browser.
OPENROUTER_API_KEY=

# Optional. Names the gateway outright, for the deliberate switch when both
# keys are present. "anthropic" or "openrouter"; anything else is ignored, so a
# typo cannot take AI generation down.
# CAPTIVATE_AI_PROVIDER=openrouter

# Optional. Overrides the model used for generation. The default is Claude
# Sonnet 5 on either gateway — "claude-sonnet-5" direct, "anthropic/claude-sonnet-5"
# through OpenRouter, which is the same model about a third cheaper.
#
# Whatever you set needs a row in `ai_model_rates` or its generations settle at
# zero cost with nothing saying so; `npm run verify` fails when the configured
# model has no price. Priced already: openai/gpt-5.2, google/gemini-3.7-flash
# and deepseek/deepseek-v3.2 (roughly a tenth of Sonnet). Any model must
# support forced tool calling — the app never parses free text.
# CAPTIVATE_AI_MODEL=anthropic/claude-sonnet-5

# Required in production. Absolute origin used in confirmation and
# password-recovery email links. Those links carry a one-time credential, and
# inferring the host from a request header lets anyone have one emailed
# pointing at a host they chose — so production sends no email at all without
# this. A dev server falls back to its own host, where there is nothing to take.
NEXT_PUBLIC_SITE_URL=

# Optional. Reserved for server code that needs to bypass RLS after already
# proving ownership by another means. No current code path reads it — do not
# provision it in a hosting provider just because it's listed here. Never
# expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Enables the "Find" tab in the image picker: stock photo search
# through Pexels. Without it that tab is absent rather than shown broken.
PEXELS_API_KEY=

# Optional. Enables the "Generate" tab. Image generation is the only thing in
# Captivate that spends money per click, so it is bounded on two axes below
# rather than by the per-user hourly limit the text tools use.
OPENAI_API_KEY=

# The image gateway resolves the same way the text one does and independently
# of it: OPENAI_API_KEY wins, an OpenRouter key alone switches to OpenRouter,
# and CAPTIVATE_IMAGE_PROVIDER ("openai" or "openrouter") settles it outright.
# So OPENROUTER_API_KEY above turns the Generate tab on too, with no second key.
# CAPTIVATE_IMAGE_PROVIDER=openrouter

# Optional. The image model. Defaults to gpt-image-2 through either gateway —
# "gpt-image-2" direct, "openai/gpt-image-2" through OpenRouter — so switching
# gateway does not also change what the pictures look like.
# google/gemini-3.1-flash-image and bytedance-seed/seedream-5-0-lite are much
# cheaper. Unlike the text model this has no rate table: an image's cost is
# reserved before the call against `public.ai_image_limits`.
# CAPTIVATE_IMAGE_MODEL=google/gemini-3.1-flash-image

# The image ceilings are not environment variables. They live in
# `public.ai_image_limits`, because the check happens in Postgres and a number
# the caller sends is a number the caller chooses — see docs/SECURITY.md.

# Billing (Stripe). Absent means there are no subscriptions, so every account
# resolves to Free — the ceilings are enforced in the database now, and it
# cannot read an environment variable. A deployment running without billing
# grants itself a plan in `plan_grants`; see docs/DEPLOYMENT.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One price per tier and interval. `planForPriceId` maps a subscription's
# stored price back to its tier, so a price that is set here is the only way a
# plan can be bought — and an unrecognised one is treated as the lowest paid
# tier rather than the highest.
#
# Each of these takes a comma-separated list, newest first. A Stripe price is
# immutable, so changing what a tier costs means a second price while everyone
# already subscribed stays on the first: keep the superseded id in the list or
# those subscribers stop resolving to the tier they bought. See
# docs/DEPLOYMENT.md.
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=

# Annual is recognised, never sold. Annual billing is deferred until measured
# cost per presentation says a year-long commitment is a safe one, and there is
# no code path that can open an annual checkout. These are read only so that a
# subscription bought before that decision still resolves to the tier its
# holder paid for.
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=

# The one-time price a top-up is bought at, in Stripe's `payment` mode rather
# than a subscription. Absent means the buy control is not shown at all — an
# unbuyable button is worse than no button.
STRIPE_PRICE_TOPUP=
NEXT_PUBLIC_SUPPORT_EMAIL=
